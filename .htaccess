# Apache / cPanel / LiteSpeed Clean URLs Configuration
Options +FollowSymLinks -MultiViews
RewriteEngine On
RewriteBase /

# 1. 301 Redirect /index.html to /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/ [NC]
RewriteRule ^index\.html$ / [R=301,L]

# 2. 301 Redirect any request containing .html to the extensionless clean URL
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.*)\.html(\?|\ ) [NC]
RewriteRule ^ %1 [R=301,L]

# 3. Internally rewrite extensionless URLs to their underlying .html file
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]
